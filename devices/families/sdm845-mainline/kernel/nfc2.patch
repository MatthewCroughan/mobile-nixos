From d59b2e9a597df7870e8362eb7921e6f7738750aa Mon Sep 17 00:00:00 2001
From: matthewcroughan <matt@croughan.sh>
Date: Sun, 20 Apr 2025 15:49:22 +0100
Subject: [PATCH] foo

---
 .../boot/dts/qcom/sdm845-oneplus-common.dtsi  | 23 ++++++++++++++++++-
 1 file changed, 22 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sdm845-oneplus-common.dtsi b/arch/arm64/boot/dts/qcom/sdm845-oneplus-common.dtsi
index 4f5877247c4c..22b8f9f8144b 100644
--- a/arch/arm64/boot/dts/qcom/sdm845-oneplus-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/sdm845-oneplus-common.dtsi
@@ -714,6 +714,19 @@ zap-shader {
 	};
 };
 
+
+&spi0 {
+	status = "okay";
+	qcom,disable-autosuspend;
+
+	ese@0 {
+		compatible = "nxp,p61";
+		reg = <0>;
+		spi-max-frequency = <8000000>;
+		nxp,nfcc="1-0028";
+	};
+};
+
 &i2c3 {
 	status = "okay";
 	clock-frequency = <400000>;
@@ -858,6 +871,15 @@ pinconf {
 			qcom,drive-strength = <0>;
 		};
 	};
+
+	nfc_clk: pm8898-gpio21-clk {
+		pinconf {
+			pins = "gpio21";
+			function = "normal";
+			input-enable;
+			power-source = <1>;
+		};
+	};
 };
 
 &pmi8998_charger {
@@ -1204,7 +1226,6 @@ &usb_1_hsphy {
 
 &tlmm {
 	gpio-reserved-ranges = <0 4>, <81 4>;
-
 	main_cam_default: main-cam-default-state {
 		mclk0 {
 			pins = "gpio13";
-- 
2.49.0


